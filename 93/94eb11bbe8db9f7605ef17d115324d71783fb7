            "content": "import { fireEvent, render, screen, waitFor } from \"@testing-library/react\";\nimport { IntlProvider } from \"react-intl\";\n\nimport { type GiftCardCreateFormCustomer } from \"./types\";\nimport { GiftCardCustomerSelectField, isValidEmailPattern } from \"./GiftCardCustomerSelectField\";\n\n// Mock IntersectionObserver\nglobal.IntersectionObserver = jest.fn().mockImplementation(() => ({\n  observe: jest.fn(),\n  unobserve: jest.fn(),\n  disconnect: jest.fn(),\n}));\n\njest.mock(\"@saleor/macaw-ui-next\", () => ({\n  DynamicCombobox: ({\n    label,\n    onChange,\n    onInputValueChange,\n    onFocus,\n    options,\n    value,\n    \"data-test-id\": testId,\n  }: any) => (\n    <div>\n      <label>{label}</label>\n      <input\n        data-test-id={testId}\n        data-testid={testId}\n        onFocus={onFocus}\n        onChange={e => {\n          onInputValueChange?.(e.target.value);\n        }}\n        value={value?.label ?? \"\"}\n        readOnly\n      />\n      <ul data-test-id=\"options-list\">\n        {(options || []).map((opt: any) => (\n          <li key={opt.value} data-test-id={`option-${opt.value}`} onClick={() => onChange?.(opt)}>\n            {opt.label}\n          </li>\n        ))}\n      </ul>\n    </div>\n  ),\n}));\n\nconst mockSearch = jest.fn();\nconst mockLoadMore = jest.fn();\n\njest.mock(\"@dashboard/searches/useCustomerSearch\", () => () => ({\n  search: mockSearch,\n  loadMore: mockLoadMore,\n  result: {\n    loading: false,\n    data: {\n      search: {\n        edges: [],\n        pageInfo: { hasNextPage: false },\n      },\n    },\n  },\n}));\n\njest.mock(\"@dashboard/hooks/useDebounce\", () => (fn: Function) => fn);\n\nconst Wrapper: React.FC<{ children: React.ReactNode }> = ({ children }) => (\n  <IntlProvider locale=\"en\">{children}</IntlProvider>\n);\n\nconst emptyCustomer: GiftCardCreateFormCustomer = { email: \"\", name: \"\" };\n\ndescribe(\"isValidEmailPattern\", () => {\n  it.each([\n    \"test@example.com\",\n    \"user.name@example.com\",\n    \"user+tag@example.co.uk\",\n    \"user-name@example.com\",\n    \"user_name@example.com\",\n    \"a@b.co\",\n    \"123@example.com\",\n    \"user!#$%&'*+/=?^_`{|}~-@example.com\",\n    \"first.last@sub.domain.example.com\",\n    \"USER@EXAMPLE.COM\",\n  ])(\"returns true for valid email %s\", email => {\n    // Act\n    const result = isValidEmailPattern(email);\n\n    // Assert\n    expect(result).toBe(true);\n  });\n\n  it.each([\n    \"\",\n    \"plainaddress\",\n    \"@example.com\",\n    \"user@\",\n    \"user@@example.com\",\n    \"user@.com\",\n    \"user @example.com\",\n    \"user@exam ple.com\",\n    \"user@-example.com\",\n    \"user@example-.com\",\n    \"user@example..com\",\n  ])(\"returns false for invalid email %s\", email => {\n    // Act\n    const result = isValidEmailPattern(email);\n\n    // Assert\n    expect(result).toBe(false);\n  });\n});\n\ndescribe(\"GiftCardCustomerSelectField\", () => {\n  beforeEach(() => {\n    jest.clearAllMocks();\n  });\n\n  it(\"renders customer combobox\", () => {\n    // Arrange & Act\n    render(\n      <Wrapper>\n        <GiftCardCustomerSelectField\n          selectedCustomer={emptyCustomer}\n          setSelectedCustomer={jest.fn()}\n        />\n      </Wrapper>,\n    );\n\n    // Assert\n    expect(screen.getByTestId(\"customer-field\")).toBeInTheDocument();\n  });\n\n  it(\"shows 'Use email' option when valid email is typed\", async () => {\n    // Arrange\n    render(\n      <Wrapper>\n        <GiftCardCustomerSelectField\n          selectedCustomer={emptyCustomer}\n          setSelectedCustomer={jest.fn()}\n        />\n      </Wrapper>,\n    );\n\n    // Act\n    const input = screen.getByTestId(\"customer-field\");\n\n    fireEvent.change(input, { target: { value: \"foo@bar.com\" } });\n\n    // Assert\n    await waitFor(() => {\n      expect(screen.getByTestId(\"option-foo@bar.com\")).toBeInTheDocument();\n      expect(screen.getByTestId(\"option-foo@bar.com\")).toHaveTextContent(\"Use email: foo@bar.com\");\n    });\n  });\n\n  it(\"calls setSelectedCustomer when email option is clicked\", async () => {\n    // Arrange\n    const setSelectedCustomer = jest.fn();\n\n    render(\n      <Wrapper>\n        <GiftCardCustomerSelectField\n          selectedCustomer={emptyCustomer}\n          setSelectedCustomer={setSelectedCustomer}\n        />\n      </Wrapper>,\n    );\n\n    // Act\n    const input = screen.getByTestId(\"customer-field\");\n\n    fireEvent.change(input, { target: { value: \"foo@bar.com\" } });\n\n    await waitFor(() => {\n      expect(screen.getByTestId(\"option-foo@bar.com\")).toBeInTheDocument();\n    });\n\n    fireEvent.click(screen.getByTestId(\"option-foo@bar.com\"));\n\n    // Assert\n    expect(setSelectedCustomer).toHaveBeenCalledWith({\n      email: \"foo@bar.com\",\n      name: \"Use email: foo@bar.com\",\n    });\n  });\n\n  it(\"clears selectedCustomer when input value changes after selection\", async () => {\n    // Arrange\n    const setSelectedCustomer = jest.fn();\n    const selectedCustomer: GiftCardCreateFormCustomer = {\n      email: \"foo@bar.com\",\n      name: \"Use email: foo@bar.com\",\n    };\n\n    render(\n      <Wrapper>\n        <GiftCardCustomerSelectField\n          selectedCustomer={selectedCustomer}\n          setSelectedCustomer={setSelectedCustomer}\n        />\n      </Wrapper>,\n    );\n\n    // Act - edit the input to a different value\n    const input = screen.getByTestId(\"customer-field\");\n\n    fireEvent.change(input, { target: { value: \"foo-bar@bar.com\" } });\n\n    // Assert - selectedCustomer should be cleared\n    await waitFor(() => {\n      expect(setSelectedCustomer).toHaveBeenCalledWith({ email: \"\", name: \"\" });\n    });\n  });\n\n  it(\"does not clear selectedCustomer when input matches selected email\", () => {\n    // Arrange\n    const setSelectedCustomer = jest.fn();\n    const selectedCustomer: GiftCardCreateFormCustomer = {\n      email: \"foo@bar.com\",\n      name: \"Use email: foo@bar.com\",\n    };\n\n    render(\n      <Wrapper>\n        <GiftCardCustomerSelectField\n          selectedCustomer={selectedCustomer}\n          setSelectedCustomer={setSelectedCustomer}\n        />\n      </Wrapper>,\n    );\n\n    // Act - type the same value as selected\n    const input = screen.getByTestId(\"customer-field\");\n\n    fireEvent.change(input, { target: { value: \"foo@bar.com\" } });\n\n    // Assert - setSelectedCustomer should NOT be called\n    expect(setSelectedCustomer).not.toHaveBeenCalled();\n  });\n\n  it(\"clears selectedCustomer on null option selection\", () => {\n    // Arrange\n    const setSelectedCustomer = jest.fn();\n\n    // We test handleSelect(null) by verifying the component calls setSelectedCustomer correctly\n    // The DynamicCombobox mock doesn't trigger null onChange, so we verify via the \"Use email\" flow\n    render(\n      <Wrapper>\n        <GiftCardCustomerSelectField\n          selectedCustomer={emptyCustomer}\n          setSelectedCustomer={setSelectedCustomer}\n        />\n      </Wrapper>,\n    );\n\n    // Assert - no selection made, setSelectedCustomer not called\n    expect(setSelectedCustomer).not.toHaveBeenCalled();\n  });\n});\n",
